# Copy to backend_v2/.env and fill in. Never commit the real file.

# Database (Supabase Postgres in production; scripts/dev_demo.sh starts a local one by itself)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_JWT_SECRET=

# Nango: Shopify and every later app
NANGO_SECRET_KEY=
NANGO_DEV_CONNECTION=

# Kumo Relational and Tabular, hosted by NVIDIA (owner's switch, D016)
NVIDIA_API_KEY=
# Or run Kumo Relational on this server (CPU, open weights): KUMO_RUNTIME=local
KUMO_RUNTIME=hosted

# Kumo Forecast and Kumo Anomaly: the GPU worker (docker-compose.gpu.yml). Empty = "needs GPU".
KUMO_GPU_URL=
KUMO_GPU_ANOMALY_URL=
